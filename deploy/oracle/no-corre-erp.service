[Unit]
Description=No Corre Central ERP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nocorre
Group=nocorre
WorkingDirectory=/opt/no-corre/erp
EnvironmentFile=/etc/no-corre/erp.env
Environment=NODE_ENV=production
Environment=PORT=3001
ExecStart=/usr/bin/node /opt/no-corre/erp/dist/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
